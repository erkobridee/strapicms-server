{
  "version": "0.0.0",
  "keywords": [],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@strapi/design-system": "^2.1.2",
    "@strapi/icons": "^2.1.2",
    "react-intl": "^7.1.14"
  },
  "devDependencies": {
    "@strapi/strapi": "5.63.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.6",
    "styled-components": "^6.3.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@strapi/typescript-utils": "5.63.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.61.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "^6.3.9"
  },
  "strapi": {
    "kind": "plugin",
    "name": "github-action-dispatch",
    "displayName": "GitHub Action Dispatch",
    "description": "Make it possible to dispatch an event into a specific GitHub repository"
  },
  "name": "github-action-dispatch",
  "description": "Make it possible to dispatch an event into a specific GitHub repository",
  "license": "MIT",
  "author": "Erko Bridee",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true,
    "core-js-pure@3.51.0": true,
    "fsevents@2.3.3": true
  }
}
